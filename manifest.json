{
  "manifest_version": 3,
  "name": "Discord Clean CSV Exporter",
  "version": "2.0.0",
  "description": "Exports Discord channel messages to CSV while omitting image and video uploads.",
  "permissions": ["activeTab", "scripting", "storage"],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Export Discord messages",
    "default_popup": "popup.html"
  }
}
